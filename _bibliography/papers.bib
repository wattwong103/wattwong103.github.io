@article{wongkaew2025ptai,
  abbr={TRR},
  title={Public Transport Accessibility Index for Bangkok and Its Application},
  author={Wongkaew, W. and others},
  abstract={Traffic congestion in Bangkok is partly due to inadequate public transport planning. This study analyzes the public transport accessibility index (PTAI) for Bangkok's inner core, considering total travel time, value of time, and number of trips. The accessibility index ranged from 0.77 to 5.45, with an average of 1.90, and generally decreases with distance from the central area of Inner Bangkok east of the Chao Phraya River, signifying spatial inequality in accessibility.},
  journal={Transportation Research Record (accepted)},
  location={Washington, D.C., USA},
  year={2025},
  annotation={* First author. Presented at the Transportation Research Board (TRB) 104th Annual Meeting; accepted in Transportation Research Record. Co-author list to be completed.},
