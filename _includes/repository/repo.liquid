{% comment %}
  Static repository card. `include.repository` is an entry from _data/repositories.yml
  (repo, description, language, optional site and project). No third-party image service.
{% endcomment %}
{% assign r = include.repository %}
{% assign repo_name = r.repo | split: '/' | last %}
{% case r.language %}
  {% when 'Python' -%}
    {%- assign lang_color = '#3572A5' %}
  {% when 'TypeScript' -%}
    {%- assign lang_color = '#3178C6' %}
  {% when 'JavaScript' -%}
    {%- assign lang_color = '#F1E05A' %}
  {% when 'SCSS' -%}
    {%- assign lang_color = '#C6538C' %}
  {% when 'CSS' -%}
    {%- assign lang_color = '#563D7C' %}
  {% else -%}
    {%- assign lang_color = '#8B949E' %}
{% endcase %}
<div class="col mb-3">
  <div class="card h-100 repo-card">
    <div class="card-body">
      <h3 class="repo-card-title">
        <i class="fa-brands fa-github" aria-hidden="true"></i>
        <a href="https://github.com/{{ r.repo }}">{{ repo_name }}</a>
      </h3>
      <p class="repo-card-desc">{{ r.description }}</p>
      <p class="repo-card-meta">
        {% if r.language %}
          <span class="repo-card-lang"><span class="repo-card-dot" style="background: {{ lang_color }}"></span>{{ r.language }}</span>
        {% endif %}
        {% if r.site %}
          <a href="{{ r.site }}">Live site</a>
        {% endif %}
        {% if r.project %}
          <a href="{{ r.project | relative_url }}">Project page</a>
        {% endif %}
      </p>
    </div>
  </div>
</div>
